# Finder metadata and editor backups must never enter stow packages: stow would
# link .DS_Store into $HOME (it is not in stow's default ignore list), and
# setup.sh's conflict pre-clearing assumes both are absent.
.DS_Store
*~

# setup.sh stows with --no-folding, so ~/.config/herdr is a real directory and
# herdr's runtime files (*.log, *.sock, session.json, .plugins.lock) stay out of
# this repo. Kept as a safety net for anyone who stows herdr by hand: without
# --no-folding stow links the directory itself and those files land in here.
# Whitelist only the hand-maintained config.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
